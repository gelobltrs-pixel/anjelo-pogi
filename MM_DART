class MobileApp {
  String appName;
  String developer;
  String version;

  MobileApp(this.appName, this.developer, this.version);

  void displayInfo() {
    print("App Name: $appName");
    print("Developer: $developer");
    print("Version: $version");
    print("");
  }
}

void main() {
  MobileApp app1 = MobileApp("Facebook", "Meta", "2026.1");
  MobileApp app2 = MobileApp("YouTube", "Google", "20.30");
  MobileApp app3 = MobileApp("TikTok", "ByteDance", "40.0");

  app1.displayInfo();
  app2.displayInfo();
  app3.displayInfo();
}